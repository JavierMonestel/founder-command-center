# Optional — without a key the app runs in demo mode (rules engine).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional — require "Authorization: Bearer <token>" on write endpoints (/api/ingest, POST /api/brief).
# INGEST_TOKEN=

# Optional — "file" (default locally) or "cookie" (default on Vercel).
# DEMO_STORAGE=file
# DATABASE_PATH=./data/founder-command-center.db
